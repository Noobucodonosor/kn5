# =============================================================================
# kn5 — file di configurazione (TEMPLATE)
# =============================================================================
# Copia questo file in `.env` e riempi i valori. `.env` è in .gitignore e NON
# va mai committato. Le variabili marcate [OPZIONALE] hanno un default sensato.
#
#   cp .env.example .env
#
# Legenda:
#   [RICHIESTO]  → senza questo il componente non parte
#   [OPZIONALE]  → ha un default, impostalo solo se vuoi cambiarlo
#   [CLOUD]      → serve solo per il deploy su Cloud Run
#   [LOCALE]     → serve solo per l'esecuzione locale
# =============================================================================

# --- Google Cloud / Vertex AI (motore di analisi Gemini) ---------------------
# [RICHIESTO] ID del progetto Google Cloud con Vertex AI abilitato.
GCP_PROJECT=

# [RICHIESTO] Bucket Google Cloud Storage per l'upload temporaneo dei video e
# (in cloud) per i report HTML. Deve esistere nel progetto sopra.
GCS_BUCKET=

# [OPZIONALE] Regione di Vertex AI / Cloud Run. Default: europe-west9.
GCP_LOCATION=europe-west9

# [OPZIONALE] Modello Gemini da usare. Default: gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_ATTEMPTS=4
GEMINI_RETRY_BASE_SECONDS=2

# [LOCALE] Percorso al file JSON delle credenziali del service account.
# In locale serve per autenticare Vertex AI + Storage.
# In cloud NON impostarlo: Cloud Run usa il proprio service account.
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# --- Bot Telegram ------------------------------------------------------------
# [RICHIESTO per il bot] Token del bot ottenuto da @BotFather.
BOT_TOKEN=

# [RICHIESTO per il bot] Il tuo Telegram user ID numerico: unico utente
# autorizzato a usare il bot. Vale anche come passcode della dashboard web.
# Per scoprirlo: scrivi a @userinfobot su Telegram.
TELEGRAM_ALLOWED_USER_ID=

# --- Autenticazione Instagram ------------------------------------------------
# Instagram blocca le richieste anonime: serve un'identità loggata.
#
# [LOCALE] Browser da cui leggere i cookie IG (devi essere loggato su Instagram
# in quel browser). Default: chrome. Valori: chrome | firefox | safari | edge | brave.
INSTAGRAM_BROWSER=chrome

# [CLOUD] Percorso a un file cookies.txt (formato Netscape) esportato dal Mac
# con `python scripts/refresh_ig_cookies.py`. Usato dove non c'è un browser.
# In cloud il deploy lo monta come secret in /secrets/ig/instagram_cookies.txt.
# INSTAGRAM_COOKIES_FILE=

# [OPZIONALE / LEGACY] Login IG usato solo dal fallback instaloader nel bulk.
# Sconsigliato (rischio checkpoint anti-bot): preferisci i cookie del browser.
# INSTAGRAM_USER=
# INSTAGRAM_PASSWORD=

# --- Scansione profili in blocco (bulk_processor / dashboard) -----------------
# [OPZIONALE] Token Apify per scansionare l'elenco post di un profilo IG in modo
# affidabile (aggira i blocchi Meta). Senza, il bulk IG ripiega su cookie/instaloader.
# Ottienilo su https://console.apify.com/account/integrations  (~$2 / 1000 risultati).
# APIFY_TOKEN=

# [OPZIONALE] Actor Apify da usare. Default: apify/instagram-scraper.
# APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper

# --- Budget (sentinella di spesa Gemini) -------------------------------------
# [OPZIONALE] Tetto di spesa mensile stimata in USD. Oltre, le chiamate Gemini
# vengono bloccate fino al mese successivo. Default: 20.
MONTHLY_BUDGET_USD=20

# [OPZIONALE] Prezzo Gemini per 1M di token (per la stima costi). Aggiornali se
# cambi modello o se cambia il listino. Default sotto = Gemini 2.5 Flash.
GEMINI_INPUT_USD_PER_1M=0.30
GEMINI_OUTPUT_USD_PER_1M=2.50

# --- Dashboard web / server Flask --------------------------------------------
# [OPZIONALE] Passcode alternativo per la dashboard web (oltre al Telegram ID).
# Se né questo né TELEGRAM_ALLOWED_USER_ID sono impostati, la dashboard è aperta.
# DASHBOARD_PASSWORD=

# [OPZIONALE] Chiave di firma delle sessioni Flask. Impostane una casuale in prod.
FLASK_SECRET_KEY=cambiami-con-una-stringa-casuale

# [OPZIONALE] Porta del server web/bot. Default: 8080.
PORT=8080

# [CLOUD] URL pubblico del servizio: se impostato, il bot registra un webhook
# invece di fare polling. Lo imposta automaticamente lo script di deploy.
# WEBHOOK_URL=

# --- Deploy Cloud Run (usati solo da deploy/cloudrun.sh) ---------------------
# [OPZIONALE] Nome del servizio Cloud Run. Default: kn5-bot.
# CLOUDRUN_SERVICE=kn5-bot

# [OPZIONALE] Percorso locale del file cookie IG da caricare come secret.
# Default: .secrets/instagram_cookies.txt
# LOCAL_IG_COOKIES=.secrets/instagram_cookies.txt
